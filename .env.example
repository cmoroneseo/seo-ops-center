# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opt-in client Overview canvas. Unset keeps the legacy Overview.
# This is separate from NEXT_PUBLIC_WORKSPACE_OVERVIEW, which only mounts the health-score widget.
NEXT_PUBLIC_WORKSPACE_CANVAS=
# Opt-in Search Reporting (Search Insights v2, Results, the month-close board, client report v2).
# Unset keeps today's reporting screens. Separate from the workspace canvas and overview flags.
NEXT_PUBLIC_SEARCH_REPORTING=
# Daily business-day-3 report drafts. Unset or anything but true writes nothing.
REPORT_AUTODRAFT_ENABLED=
# Scheduled client-report email on business day 5 at 9:00 AM Pacific.
# Unset or anything but true queues nothing and emails nothing.
REPORT_SEND_ENABLED=
# Opt-in Monday work digest. Unset or anything but true queues nothing and emails nothing.
# Each client also stays off until staff turn on weekly email in the portal settings.
WEEKLY_DIGEST_ENABLED=
CRON_SECRET=your_random_cron_secret

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_starter_placeholder
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_pro_placeholder
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=price_agency_placeholder

# Email Configuration
RESEND_API_KEY=your_resend_api_key

# Google OAuth / Search Integrations
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# 32-byte AES key for Google access and refresh tokens at rest.
# One key: base64 or base64url. Rotation: kid:base64,previousKid:base64
# (the first pair is the current write key). Optional GOOGLE_TOKEN_ENC_KEY_ID
# selects a different current kid that is already in the list.
# Set this before deploying token encryption. Leave empty only in local dev.
GOOGLE_TOKEN_ENC_KEY=
GOOGLE_TOKEN_ENC_KEY_ID=

# Basecamp Integration
BASECAMP_CLIENT_ID=your_basecamp_client_id
BASECAMP_CLIENT_SECRET=your_basecamp_client_secret
BASECAMP_REDIRECT_URI=http://localhost:3000/api/integrations/basecamp/callback
BASECAMP_ACCESS_TOKEN=your_basecamp_access_token
BASECAMP_REFRESH_TOKEN=your_basecamp_refresh_token
BASECAMP_ACCOUNT_ID=your_basecamp_account_id
BASECAMP_OAUTH_STATE_SECRET=your_random_oauth_state_signing_secret

# Admin scripts (not used by the app runtime)
# Consumed by scripts/set-user-password.mjs to set an email/password on an
# existing (e.g. Google-OAuth) Supabase user. Supply at run time; never commit a real value.
NEW_USER_PASSWORD=your_new_password

# Verified Resend sender used for client portal invites and notifications
RESEND_FROM_EMAIL=

# Search Console history. GSC_HISTORY_ENABLED is the existing daily sync.
# The v2 flags stay empty until Supabase is on Pro. V2 ingests new grains and
# monthly finality. BACKFILL is the separate 16-month refetch.
GSC_HISTORY_ENABLED=
GSC_HISTORY_V2_ENABLED=
GSC_HISTORY_V2_BACKFILL_ENABLED=

# Content writer. Flags default off. Only the exact value true turns one on.
# CONTENT_WRITER_ENABLED is the master switch. CONTENT_WRITER_LLM_ENABLED
# allows model calls and also requires the master switch.
# CONTENT_WRITER_SPEC_ENABLED shows the page spec drawer and manual add.
# It also requires the master switch. Apply migration 083 before turning it on.
# CONTENT_WRITER_ORG_IDS is an optional comma-separated allowlist. When set,
# only those organizations pass any of the flags. Leave it empty to allow every
# org once the flags are on.
CONTENT_WRITER_ENABLED=
CONTENT_WRITER_LLM_ENABLED=
CONTENT_WRITER_SPEC_ENABLED=
CONTENT_WRITER_ORG_IDS=

# Context Vault. Off unless VAULT_ENABLED is exactly true AND the organization
# id is in VAULT_ORG_IDS. Start with the Sandbox org only. Do not apply
# migration 086 until that allowlist is intentional.
# 06e536b9-beac-49bc-8c96-1df021102590
VAULT_ENABLED=
VAULT_ORG_IDS=

# SEO Plan v2 workspace (Overview, Plan, Tasks, Search, More).
# Off unless SEO_PLAN_V2 is exactly true AND the organization id is in
# SEO_PLAN_V2_ORG_IDS. Start with the Sandbox org only.
# 06e536b9-beac-49bc-8c96-1df021102590
SEO_PLAN_V2=
SEO_PLAN_V2_ORG_IDS=

# Agency Dashboard (Search Console portfolio). Separate from Home.
# Off unless AGENCY_DASHBOARD is exactly true AND the organization id is in
# AGENCY_DASHBOARD_ORG_IDS. Start with the Sandbox org only.
# Apply migration 090 before turning it on. 089 stays reserved.
# 06e536b9-beac-49bc-8c96-1df021102590
AGENCY_DASHBOARD=
AGENCY_DASHBOARD_ORG_IDS=

# GA4 numbers on the agency client cards. Off unless NEXT_PUBLIC_GA4_CARDS
# is exactly true. The toggle is Clicks, Organic sessions, or Key events,
# stored in the ?metric= query. Apply migration 098 before turning it on.
# A client without a mapped GA4 property shows an em dash, never 0.
NEXT_PUBLIC_GA4_CARDS=

# Bing Webmaster. Off unless BING_WEBMASTER is exactly true AND the organization
# id is in BING_WEBMASTER_ORG_IDS. Empty stays off. Start with the Sandbox org
# only. Migration 094 is already applied. The sync writes nothing while this
# flag is off.
# 06e536b9-beac-49bc-8c96-1df021102590
BING_WEBMASTER=
BING_WEBMASTER_ORG_IDS=
# Server-only API key. Never NEXT_PUBLIC_ and never log it. The daily sync
# skips when this is empty. Set the real value in Vercel, not in this file.
BING_WEBMASTER_API_KEY=

# Campaign Desk forecast sync. Manual only — there is no cron.
# Off unless CAMPAIGN_DESK_SYNC_ENABLED is exactly true AND the organization
# id is in CAMPAIGN_DESK_ORG_IDS. Empty stays off. Start with the Sandbox org
# only. Apply migration 095 before turning it on. Do not add the production
# org until a sandbox sync has been checked.
# 06e536b9-beac-49bc-8c96-1df021102590
CAMPAIGN_DESK_SYNC_ENABLED=
CAMPAIGN_DESK_ORG_IDS=
# Server-only. Never NEXT_PUBLIC_ and never log it. https required
# (http://localhost is accepted for a local Campaign Desk). The sync sends
# nothing while any of these are empty.
CAMPAIGN_DESK_API_BASE_URL=
CAMPAIGN_DESK_API_TOKEN=
# Payload version. Empty keeps version 1 (weekly totals). Exactly true sends
# version 2 (one item per day). Apply migration 099 before turning this on.
# Version 1 does not read the client map.
CAMPAIGN_DESK_SYNC_V2=

# Vercel AI Gateway. Live model calls need AI_GATEWAY_API_KEY.
# On Vercel, VERCEL_OIDC_TOKEN is provided for the deployment and can
# authenticate instead. Never commit a real key. The content-writer flags
# stay off until both the key and the migration are in place.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
